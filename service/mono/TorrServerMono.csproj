<!--
  Служба для Android: те же исходники, что в пакете для Tizen, под Mono из Termux
  (приложение android/ запускает её как отдельную программу: mono TorrServer.exe).
  .NET Framework 4.7.2 — профиль, который есть в Mono; MonoTorrent берёт сборку net472.
  Сборка: python android/tools/fetch-runtime.py (или dotnet build -c Release)
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>TorrServer</AssemblyName>
    <RootNamespace>TorrStreamTorrServer</RootNamespace>
    <!-- Как у сборки для Tizen: исходники общие и должны собираться C# 8 -->
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- SSL_read/SSL_write в буфер со смещением (OpenSsl.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- TorrServer.exe.config с перенаправлениями версий (System.Memory и др.) — Mono их читает -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../*.cs" Exclude="../Program.cs" />
    <EmbeddedResource Include="../web/index.html" LogicalName="web.index.html" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
