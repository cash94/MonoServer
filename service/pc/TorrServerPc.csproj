<!--
  Проверка службы на ПК: те же исходники, что в пакете для Tizen, без Program.cs
  (обвязки Tizen). Запуск: dotnet run, аргументы — порт и каталог данных (pc/Main.cs)
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MonoServer</AssemblyName>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    GC на сегментах (GcSwitch.cs): libclrgc.so из пакета рантайма — ресурсом в
    программу (она сама кладёт его рядом с собой) и файлом рядом в публикации (архив,
    monoserver.sh install). Только Linux: на Windows не проверено, а не загрузившийся
    GC — служба не стартует
  -->
  <Target Name="ClrGc" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveFrameworkReferences" Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <PropertyGroup>
      <_ClrGcName>libclrgc.so</_ClrGcName>
    </PropertyGroup>
    <ItemGroup>
      <_ClrGc Include="@(ResolvedRuntimePack->'%(PackageDirectory)/runtimes/$(RuntimeIdentifier)/native/$(_ClrGcName)')" />
      <EmbeddedResource Include="@(_ClrGc)" LogicalName="clrgc" Condition="Exists('%(Identity)')" />
    </ItemGroup>
  </Target>
  <Target Name="ClrGcBesideExe" AfterTargets="ComputeResolvedFilesToPublishList" Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_ClrGc)" Condition="Exists('%(Identity)')">
        <RelativePath>$(_ClrGcName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../*.cs" Exclude="../Program.cs" />
    <Compile Include="../Utp/*.cs" />
    <EmbeddedResource Include="../web/index.html" LogicalName="web.index.html" />
    <EmbeddedResource Include="../web/login.html" LogicalName="web.login.html" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <!-- База MonoServer (Accounts.cs): чистый C#, без нативного кода -->
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

</Project>
