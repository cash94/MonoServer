<!--
  Проверка службы на ПК: те же исходники, что в пакете для Tizen, без Program.cs
  (обвязки Tizen). Запуск: dotnet run, аргументы — порт и каталог данных (pc/Main.cs)
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MonoServer</AssemblyName>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../*.cs" Exclude="../Program.cs" />
    <Compile Include="../Utp/*.cs" />
    <EmbeddedResource Include="../web/index.html" LogicalName="web.index.html" />
    <EmbeddedResource Include="../web/login.html" LogicalName="web.login.html" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <!-- База MonoServer (Accounts.cs): чистый C#, без нативного кода -->
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

</Project>
